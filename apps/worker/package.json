{
  "name": "@cc/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --alias:@cc/shared=../../packages/shared/src/index.ts --sourcemap --outfile=dist/index.cjs",
    "start": "node dist/index.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@cc/shared": "*",
    "@supabase/supabase-js": "^2.50.0",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.12.0",
    "pino": "^9.6.0",
    "unpdf": "^1.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
