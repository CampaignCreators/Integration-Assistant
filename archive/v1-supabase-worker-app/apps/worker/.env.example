# Supabase (worker uses the service-role key — server-side only, never exposed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Claude API (used from Phase 2 for research + generation)
ANTHROPIC_API_KEY=

# Optional external search provider (Anthropic built-in web search is the default)
WEB_SEARCH_API_KEY=

# CORS origin of the Next.js app
WEB_ORIGIN=http://localhost:3000

PORT=8080
POLL_INTERVAL_MS=3000

# Model + research tuning (defaults shown)
ANTHROPIC_MODEL=claude-opus-5
# Set to "true" only if your account rejects the refusal-fallback beta
ANTHROPIC_DISABLE_FALLBACKS=
WEB_SEARCH_MAX_USES=12
WEB_FETCH_MAX_USES=12
# Used to estimate per-run cost; confirm against current Anthropic pricing
WEB_SEARCH_COST_PER_1K=10

# Reliability + cost control
STEP_MAX_ATTEMPTS=3
STEP_BACKOFF_MS=2000
MAX_CONCURRENT_RUNS=3

# Reliability (Phase 5)
# Must exceed the slowest pipeline step, or a live run may be adopted twice
STALE_RUN_MINUTES=20
# Time allowed for in-flight runs to finish on SIGTERM
SHUTDOWN_GRACE_MS=25000

# Offline demo mode: return canned research findings instead of calling Claude,
# so the app can be exercised without an Anthropic key. Findings are marked as
# fake and confidence is forced low. Ignored when NODE_ENV=production.
LLM_OFFLINE_DEMO=
