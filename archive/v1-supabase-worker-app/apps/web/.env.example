# Supabase (public — safe for the browser; RLS enforces access)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where this app is served (used for magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Express worker base URL (server-side only)
WORKER_BASE_URL=http://localhost:8080

# Local development only: enables a one-click "sign in as" button on the login
# page for this seeded user. A real password sign-in, so RLS and roles still
# apply. Ignored unless NODE_ENV is non-production AND the Supabase URL above is
# local, so these lines are inert in a deployment. Written by scripts/dev-setup.sh.
LOCAL_DEV_EMAIL=
LOCAL_DEV_PASSWORD=
