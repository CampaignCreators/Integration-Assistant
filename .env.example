# Anthropic API key. Without one the app runs in demo mode and returns clearly
# marked placeholder output instead of calling Claude.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
ANTHROPIC_MODEL=claude-opus-5
# Let Claude look up the other system's API docs while drafting the mapping.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=6
