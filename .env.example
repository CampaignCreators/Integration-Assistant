# ─── Claude ──────────────────────────────────────────────────────────────────
# Without a key the app runs in demo mode: the whole flow works, but the output
# is clearly-labelled placeholder text. Required in production.
ANTHROPIC_API_KEY=

# ─── Supabase (optional) ─────────────────────────────────────────────────────
# Set both to get sign-in, saved runs, and uploads kept in private storage.
# Leave both blank and the app keeps one draft in the browser instead.
# Setup: docs/setup.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Optional overrides (defaults shown) ─────────────────────────────────────
ANTHROPIC_MODEL=claude-opus-5
# Let Claude look up the other system's API docs while drafting the mapping.
# Turn off to keep runs short — needed on Vercel's Hobby plan (60s cap).
ENABLE_WEB_SEARCH=true
WEB_SEARCH_MAX_USES=6
